# Copia a .env y reemplaza los valores localmente o en tu hosting.
# El archivo .env real está excluido de Git y bloqueado por .htaccess.
MM_DB_HOST=localhost
MM_DB_NAME=
MM_DB_USER=
MM_DB_PASS=
# Entorno del proceso > .env privado > constantes antiguas de config/local.php.
# Mantén vacío Google si no utilizas ese proveedor. Nunca publiques el secreto real.
MM_GOOGLE_CLIENT_ID=
MM_GOOGLE_CLIENT_SECRET=
MM_GOOGLE_REDIRECT_URI="https://TU_DOMINIO/MusicMad_PWA/google-regreso.php"
MM_JWT_SECRET=
# Si se omite, el primer acceso genera una clave en .env y una transición
# de 30 minutos, si PHP puede escribir. No uses claves de ejemplo en producción.
# También puedes definir la clave en config/local.php o entorno del hosting.
# MM_ENC_KEY=<64 caracteres hex aleatorios>
# Para configuración manual durante esta actualización:
# MM_ENC_KEY_LEGACY_UNTIL=<timestamp Unix de ahora + 1800 segundos>
# Tras esa fecha las credenciales DB dejan de intervenir en las huellas.
# Web Push: genera claves una vez en el hosting; conserva el par privado.
MM_VAPID_PUBLIC_KEY=
MM_VAPID_PRIVATE_KEY=
MM_VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"


# Dirección fija para links y futuras comunicaciones por correo.
# MM_APP_URL="https://tu-dominio/MusicMad_PWA"
# Solo para el proxy HTTPS de confianza de tu proveedor:
# MM_TRUST_PROXY="1"


# SMTP privado; exige TLS/SSL y MM_APP_URL HTTPS para los enlaces.
MM_MAIL_HOST=
MM_MAIL_PORT=587
MM_MAIL_USER=
MM_MAIL_PASS=
MM_MAIL_FROM=
MM_MAIL_NAME=MusicMad
MM_MAIL_ENCRYPTION=tls
MM_MAIL_TRANSPORT=smtp


# Optional short SSE requests under Apache. Polling remains available.
MM_CHAT_SSE=0
